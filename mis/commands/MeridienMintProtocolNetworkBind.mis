// Moniversive Invariant Static (MIS) — deep root
// Creator: Chandler William Ferguson
// Network bind for clarity-fintech/meridien-mint-protocol
// Compile: bin/misc <file>.mis --check --compact-letters

module MeridienMintProtocolNetworkBind {
  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant extension_mis: source_extension == mis;
  invariant no_python_kernel: python_package_code == false;
  invariant l1_only: foreign_chain_id == @0;
  invariant domain_bound: domain == meridien_mint;
  invariant creator_bound: creator == chandler_william_ferguson;
  invariant finality_cap_ms_bound: finality_cap_ms == 400;
  invariant network_mainnet_bound: mainnet_rpc_bound == true;
  invariant network_testnet_bound: testnet_rpc_bound == true;
  invariant network_devnet_bound: devnet_rpc_bound == true;

  outcome bind_language_root() {
    constraint language_root_bound == true;
    constraint deep_root == moniversive;
  }

  outcome bind_rpc() {
    constraint rpc_gateway_bound == true;
    constraint chain_id == 1202;
  }

  outcome bind_mesh() {
    constraint staking_priority_mesh == true;
    constraint mis_router_bound == true;
  }

  outcome bind_cherry() {
    constraint cherry_vds_bound == true;
  }

  outcome bind_index() {
    constraint mis_code_index_bound == true;
  }

  outcome bind_testnet() {
    constraint testnet_rpc_bound == true;
    constraint chain_id == 1202;
    constraint finality_cap_ms == 400;
  }

  outcome bind_devnet() {
    constraint devnet_rpc_bound == true;
    constraint chain_id == 1202;
    constraint finality_cap_ms == 400;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
    constraint settlement_network == clrty_1;
  }
}
