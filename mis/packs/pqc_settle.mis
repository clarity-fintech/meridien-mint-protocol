  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant settlement_network_clrty1: settlement_network == clrty_1;
  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_pqc_settle_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant pqc_settle_041: pqc_settle_041_bound == true;
  invariant pqc_settle_042: pqc_settle_042_bound == true;
  invariant pqc_settle_043: pqc_settle_043_bound == true;
  invariant pqc_settle_044: pqc_settle_044_bound == true;
  invariant pqc_settle_045: pqc_settle_045_bound == true;
