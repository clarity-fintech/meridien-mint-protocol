  invariant clrty1_usdc_098: clrty1_usdc_098_bound == true;
  invariant clrty1_usdc_099: clrty1_usdc_099_bound == true;
  invariant clrty1_usdc_100: clrty1_usdc_100_bound == true;

  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

