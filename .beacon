// CLRTY-MERIDIEN-MINT-PROTOCOL node beacon — clarity-fintech / clrty-1 / 1202
// GitHub: https://github.com/clarity-fintech/meridien-mint-protocol
// Check twin: bin/misc moniversive/framework/beacons/meridien-mint-protocol.mis --check --compact-letters

module ClrtyMeridienMintProtocolBeacon {

  invariant letter_hash_bound: letter_hash_root != @0;
  invariant deep_root_moniversive: deep_root == moniversive;
  invariant settlement_chain: chain_id == 1202;
  invariant beacon_id: beacon_id == clrty_meridien_mint_protocol;
  invariant node_name: node_name == clrty_meridien_mint_protocol;

  outcome heartbeat(seq: Bytes) {
    require seq != @0;
    constraint chain_id == 1202;
    constraint heartbeat_ok == true;
  }

  outcome superstructure_bind(catalog: Bytes) {
    require catalog != @0;
    constraint superstructure_linked == true;
  }

  outcome letter_hash(payload: Bytes) {
    require payload != @0;
    constraint letter_root != @0;
  }
}
